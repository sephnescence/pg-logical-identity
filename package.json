{
  "name": "pg-logical-identity",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "description": "Deterministic logical identity tracking for Postgres tables and columns across renames and schema clones",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:snapshot": "node scripts/snapshot-db.js",
    "migration:new": "node scripts/new-migration.js",
    "migration:apply": "node scripts/apply-migrations.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "test:full": "pnpm db:up && pnpm test"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
